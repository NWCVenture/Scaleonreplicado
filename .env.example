# === Banco de dados ===
DATABASE_URL=postgresql://user:pass@host:port/db

# === Better-Auth ===
BETTER_AUTH_SECRET=           # openssl rand -hex 32
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=

# === App ===
NEXT_PUBLIC_APP_NAME=SCALEON ERP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Email (Resend) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# === Vercel Blob Storage ===
# Necessário em dev pra exercitar o upload de etiquetas (Expedição Diária),
# coletas e imagens de modelo. Pegar em:
# Vercel Dashboard → Project → Storage → <blob store> → aba .env.local
BLOB_READ_WRITE_TOKEN=

# === Módulo de Canais — Integração Marketplaces ===

# Criptografia de credenciais OAuth (AES-256-GCM)
# Gerar: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Secret do HMAC do state OAuth (DIFERENTE da ENCRYPTION_MASTER_KEY)
# Gerar: openssl rand -base64 32
OAUTH_STATE_SECRET=

# TikTok Shop — Custom App no Partner Center
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_WEBHOOK_KEY=
TIKTOK_SHOP_API_VERSION=202309
TIKTOK_SHOP_REGION=BR

# Inngest — conta gratuita em inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# === Módulo Confecção — Crons ===

# Secret usado pelo Vercel Cron pra autorizar o endpoint
# /api/confeccao/jobs/alertas-atraso (RITM-22).
# Em produção, a Vercel injeta automaticamente no header
# `Authorization: Bearer <CRON_SECRET>`. Em dev, basta setar localmente
# pra testar o endpoint via curl.
# Gerar: openssl rand -base64 32
CRON_SECRET=

# === Módulo Confecção — Lalamove API (RITM-25+) ===

# Feature flag global. Quando "true", UI mostra "Cotar via API" e endpoints
# da integração respondem; quando "false" (ou qualquer outro valor), só o
# fluxo manual funciona. Default: false.
LALAMOVE_FEATURE_FLAG=false

# Host da API. RITM-25/26 usam sandbox em todos os ambientes (cotação
# assistida não cria order de verdade).
# Sandbox: https://rest.sandbox.lalamove.com
# Produção: https://rest.lalamove.com  (só ativar quando RITM-27 estiver pronta)
LALAMOVE_API_HOST=https://rest.sandbox.lalamove.com

# Mercado. BR pra nossa operação.
LALAMOVE_MARKET=BR

# Chaves emitidas pela Lalamove Partner Portal.
# Sandbox: pk_test_* / sk_test_*
# Produção: pk_prod_* / sk_prod_*
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
